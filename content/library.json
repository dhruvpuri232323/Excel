{"functions": [{"name": "SUM", "cat": "Maths", "course": "C1", "short": "Adds numbers", "what": "Adds every number in the cells or values you give it. Text and blank cells are skipped.", "syntax": "=SUM(number1, [number2], …)", "args": [["number1", "A cell, a range like `B2:B6`, or a number"], ["number2…", "More cells or ranges (optional)"]], "example": {"sheet": {"sheets": [{"name": "Try it", "cells": {"A1": "Student", "B1": "Maths", "C1": "Science", "A2": "Asha", "B2": 78, "C2": 91, "A3": "Ravi", "B3": 64, "C3": 55, "A4": "Meena", "B4": 89, "C4": 72, "A5": "Karan", "B5": 45, "C5": "absent", "A6": "Zoya", "B6": 92, "C6": 88, "A8": "Total", "B8": "=SUM(B2:B6)"}, "widths": {"A": 16, "B": 12, "C": 12, "D": 14, "E": 14}}]}, "cell": "B8", "say": "B8 adds the maths marks. Change a mark and watch the total update. Then try `=SUM(B2:C6)`."}, "mistakes": ["Typing the answer instead of a formula, so it never updates.", "Leaving a row out of the range when you add data below it.", "Expecting SUM to add text that only looks like a number (it skips it)."], "related": ["AVERAGE", "COUNT"]}, {"name": "AVERAGE", "cat": "Statistics", "course": "C1", "short": "The mean of numbers", "what": "Adds the numbers and divides by how many numbers there are. Blank cells and text don’t count, so they don’t drag the average down.", "syntax": "=AVERAGE(number1, [number2], …)", "args": [["number1", "Cells, a range or numbers"]], "example": {"sheet": {"sheets": [{"name": "Try it", "cells": {"A1": "Student", "B1": "Maths", "C1": "Science", "A2": "Asha", "B2": 78, "C2": 91, "A3": "Ravi", "B3": 64, "C3": 55, "A4": "Meena", "B4": 89, "C4": 72, "A5": "Karan", "B5": 45, "C5": "absent", "A6": "Zoya", "B6": 92, "C6": 88, "A8": "Average", "B8": "=AVERAGE(B2:B6)", "C8": "=AVERAGE(C2:C6)"}, "widths": {"A": 16, "B": 12, "C": 12, "D": 14, "E": 14}}]}, "cell": "C8", "say": "C8 averages science, where Karan is “absent”: the text is skipped, so the average is over four people."}, "mistakes": ["Treating a blank as zero: AVERAGE ignores blanks, but a typed 0 counts.", "Averaging averages from groups of different sizes."], "related": ["SUM", "MEDIAN", "COUNT"]}, {"name": "MIN", "cat": "Statistics", "course": "C1", "short": "The smallest number", "what": "Returns the smallest number in the cells you give it.", "syntax": "=MIN(number1, [number2], …)", "args": [["number1", "Cells, a range or numbers"]], "example": {"sheet": {"sheets": [{"name": "Try it", "cells": {"A1": "Student", "B1": "Maths", "C1": "Science", "A2": "Asha", "B2": 78, "C2": 91, "A3": "Ravi", "B3": 64, "C3": 55, "A4": "Meena", "B4": 89, "C4": 72, "A5": "Karan", "B5": 45, "C5": "absent", "A6": "Zoya", "B6": 92, "C6": 88, "A8": "Lowest", "B8": "=MIN(B2:B6)"}, "widths": {"A": 16, "B": 12, "C": 12, "D": 14, "E": 14}}]}, "cell": "B8", "say": "B8 finds the lowest maths mark."}, "mistakes": ["MIN of an empty range is 0, not blank."], "related": ["MAX", "SMALL"]}, {"name": "MAX", "cat": "Statistics", "course": "C1", "short": "The largest number", "what": "Returns the largest number in the cells you give it.", "syntax": "=MAX(number1, [number2], …)", "args": [["number1", "Cells, a range or numbers"]], "example": {"sheet": {"sheets": [{"name": "Try it", "cells": {"A1": "Student", "B1": "Maths", "C1": "Science", "A2": "Asha", "B2": 78, "C2": 91, "A3": "Ravi", "B3": 64, "C3": 55, "A4": "Meena", "B4": 89, "C4": 72, "A5": "Karan", "B5": 45, "C5": "absent", "A6": "Zoya", "B6": 92, "C6": 88, "A8": "Highest", "B8": "=MAX(B2:B6)", "A9": "Spread", "B9": "=MAX(B2:B6)-MIN(B2:B6)"}, "widths": {"A": 16, "B": 12, "C": 12, "D": 14, "E": 14}}]}, "cell": "B9", "say": "B9 shows the spread between the best and worst maths marks."}, "mistakes": ["Using MAX on dates gives the latest date, which is often exactly what you want."], "related": ["MIN", "LARGE"]}, {"name": "COUNT", "cat": "Statistics", "course": "C1", "short": "How many numbers", "what": "Counts the cells that hold numbers (dates count too). Text and blanks are not counted.", "syntax": "=COUNT(value1, [value2], …)", "args": [["value1", "Cells or a range"]], "example": {"sheet": {"sheets": [{"name": "Try it", "cells": {"A1": "Student", "B1": "Maths", "C1": "Science", "A2": "Asha", "B2": 78, "C2": 91, "A3": "Ravi", "B3": 64, "C3": 55, "A4": "Meena", "B4": 89, "C4": 72, "A5": "Karan", "B5": 45, "C5": "absent", "A6": "Zoya", "B6": 92, "C6": 88, "A8": "Marks entered", "C8": "=COUNT(C2:C6)"}, "widths": {"A": 16, "B": 12, "C": 12, "D": 14, "E": 14}}]}, "cell": "C8", "say": "C8 counts science marks: 4, because “absent” is text."}, "mistakes": ["Using COUNT to count names: it ignores text. Use COUNTA."], "related": ["COUNTA", "COUNTBLANK"]}, {"name": "COUNTA", "cat": "Statistics", "course": "C1", "short": "How many filled cells", "what": "Counts every cell that isn’t empty: numbers, text, dates, TRUE/FALSE and errors.", "syntax": "=COUNTA(value1, [value2], …)", "args": [["value1", "Cells or a range"]], "example": {"sheet": {"sheets": [{"name": "Try it", "cells": {"A1": "Student", "B1": "Maths", "C1": "Science", "A2": "Asha", "B2": 78, "C2": 91, "A3": "Ravi", "B3": 64, "C3": 55, "A4": "Meena", "B4": 89, "C4": 72, "A5": "Karan", "B5": 45, "C5": "absent", "A6": "Zoya", "B6": 92, "C6": 88, "A8": "Students", "B8": "=COUNTA(A2:A6)"}, "widths": {"A": 16, "B": 12, "C": 12, "D": 14, "E": 14}}]}, "cell": "B8", "say": "B8 counts the student names."}, "mistakes": ["A cell with a space in it looks empty but is counted."], "related": ["COUNT", "COUNTBLANK"]}, {"name": "COUNTBLANK", "cat": "Statistics", "course": "C1", "short": "How many empty cells", "what": "Counts the empty cells in a range.", "syntax": "=COUNTBLANK(range)", "args": [["range", "The cells to check"]], "example": {"sheet": {"sheets": [{"name": "Try it", "cells": {"A1": "Roll no", "B1": "Fee paid", "A2": 1, "B2": 1500, "A3": 2, "A4": 3, "B4": 1500, "A5": 4, "A7": "Unpaid", "B7": "=COUNTBLANK(B2:B5)"}, "widths": {"A": 16, "B": 12, "C": 12, "D": 14, "E": 14}}]}, "cell": "B7", "say": "B7 counts students who haven’t paid yet."}, "mistakes": ["A formula that returns \"\" counts as blank."], "related": ["COUNTA"]}, {"name": "ROUND", "cat": "Maths", "course": "C2", "short": "Round to some decimals", "what": "Rounds a number to the number of decimal places you choose. Formatting only changes how a number looks; ROUND changes the number itself.", "syntax": "=ROUND(number, num_digits)", "args": [["number", "The number to round"], ["num_digits", "Decimal places; 0 for whole numbers, -2 for hundreds"]], "example": {"sheet": {"sheets": [{"name": "Try it", "cells": {"A1": "Price", "B1": 1299.456, "A2": "Rounded", "B2": "=ROUND(B1,2)", "A3": "To hundreds", "B3": "=ROUND(B1,-2)"}, "widths": {"A": 16, "B": 12, "C": 12, "D": 14, "E": 14}}]}, "cell": "B2", "say": "Change B1 and compare B2 and B3."}, "mistakes": ["Rounding with the format buttons, then wondering why totals are off by a paisa."], "related": ["ROUNDUP", "ROUNDDOWN", "INT"]}, {"name": "ROUNDUP", "cat": "Maths", "course": "C2", "short": "Round away from zero", "what": "Rounds up to the decimals you choose, for example for packs or boxes needed.", "syntax": "=ROUNDUP(number, num_digits)", "args": [["number", "The number"], ["num_digits", "Decimal places"]], "example": {"sheet": {"sheets": [{"name": "Try it", "cells": {"A1": "Students", "B1": 53, "A2": "Per bus", "B2": 20, "A3": "Buses", "B3": "=ROUNDUP(B1/B2,0)"}, "widths": {"A": 16, "B": 12, "C": 12, "D": 14, "E": 14}}]}, "cell": "B3", "say": "53 students at 20 a bus need 3 buses, not 2.65."}, "mistakes": ["Using ROUND when you must never fall short."], "related": ["ROUND", "ROUNDDOWN"]}, {"name": "ROUNDDOWN", "cat": "Maths", "course": "C2", "short": "Round towards zero", "what": "Rounds down to the decimals you choose.", "syntax": "=ROUNDDOWN(number, num_digits)", "args": [["number", "The number"], ["num_digits", "Decimal places"]], "example": {"sheet": {"sheets": [{"name": "Try it", "cells": {"A1": "Hours", "B1": 7.9, "A2": "Full hours", "B2": "=ROUNDDOWN(B1,0)"}, "widths": {"A": 16, "B": 12, "C": 12, "D": 14, "E": 14}}]}, "cell": "B2", "say": "Only full hours count."}, "mistakes": ["ROUNDDOWN(-2.5,0) gives -2: it moves towards zero."], "related": ["ROUND", "INT"]}, {"name": "INT", "cat": "Maths", "course": "C2", "short": "Whole-number part", "what": "Rounds a number down to the nearest whole number.", "syntax": "=INT(number)", "args": [["number", "The number"]], "example": {"sheet": {"sheets": [{"name": "Try it", "cells": {"A1": 7.9, "B1": "=INT(A1)", "A2": -7.9, "B2": "=INT(A2)"}, "widths": {"A": 16, "B": 12, "C": 12, "D": 14, "E": 14}}]}, "cell": "B2", "say": "INT always rounds down, so -7.9 becomes -8."}, "mistakes": [], "related": ["ROUNDDOWN", "MOD"]}, {"name": "MOD", "cat": "Maths", "course": "C2", "short": "Remainder after division", "what": "Returns what’s left over after dividing.", "syntax": "=MOD(number, divisor)", "args": [["number", "The number to divide"], ["divisor", "What to divide by"]], "example": {"sheet": {"sheets": [{"name": "Try it", "cells": {"A1": "Roll no", "B1": "Group", "A2": 17, "B2": "=MOD(A2,3)"}, "widths": {"A": 16, "B": 12, "C": 12, "D": 14, "E": 14}}]}, "cell": "B2", "say": "Split students into three groups by roll number."}, "mistakes": ["Dividing by 0 gives #DIV/0!."], "related": ["INT"]}, {"name": "PRODUCT", "cat": "Maths", "course": "C1", "short": "Multiply numbers", "what": "Multiplies all the numbers you give it.", "syntax": "=PRODUCT(number1, …)", "args": [["number1", "Cells or numbers"]], "example": {"sheet": {"sheets": [{"name": "Try it", "cells": {"A1": "Qty", "B1": "Price", "C1": "Amount", "A2": 3, "B2": 250, "C2": "=PRODUCT(A2:B2)"}, "widths": {"A": 16, "B": 12, "C": 12, "D": 14, "E": 14}}]}, "cell": "C2", "say": "Same as `=A2*B2`."}, "mistakes": ["Blank cells are skipped, not treated as zero."], "related": ["SUM"]}, {"name": "ABS", "cat": "Maths", "course": "C2", "short": "Drop the minus sign", "what": "Returns a number without its sign.", "syntax": "=ABS(number)", "args": [["number", "The number"]], "example": {"sheet": {"sheets": [{"name": "Try it", "cells": {"A1": "Variance", "B1": -1200, "C1": "=ABS(B1)"}, "widths": {"A": 16, "B": 12, "C": 12, "D": 14, "E": 14}}]}, "cell": "C1", "say": "Useful for the size of a gap either way."}, "mistakes": [], "related": []}, {"name": "SQRT", "cat": "Maths", "course": "C2", "short": "Square root", "what": "Returns the positive square root.", "syntax": "=SQRT(number)", "args": [["number", "A number, not negative"]], "example": {"sheet": {"sheets": [{"name": "Try it", "cells": {"A1": 144, "B1": "=SQRT(A1)"}, "widths": {"A": 16, "B": 12, "C": 12, "D": 14, "E": 14}}]}, "cell": "B1", "say": ""}, "mistakes": ["A negative number gives #NUM!."], "related": ["POWER"]}, {"name": "POWER", "cat": "Maths", "course": "C2", "short": "Raise to a power", "what": "Raises a number to a power, same as the ^ operator.", "syntax": "=POWER(number, power)", "args": [["number", "The base"], ["power", "The exponent"]], "example": {"sheet": {"sheets": [{"name": "Try it", "cells": {"A1": "Principal", "B1": 100000, "A2": "Rate", "B2": 0.08, "A3": "After 5 years", "B3": "=B1*POWER(1+B2,5)"}, "widths": {"A": 16, "B": 12, "C": 12, "D": 14, "E": 14}}]}, "cell": "B3", "say": "Compound growth over five years."}, "mistakes": [], "related": ["SQRT"]}, {"name": "TODAY", "cat": "Date & time", "course": "C2", "short": "Today’s date", "what": "Returns today’s date. It updates every time the workbook recalculates.", "syntax": "=TODAY()", "args": [], "example": {"sheet": {"sheets": [{"name": "Try it", "cells": {"A1": "Today", "B1": {"f": "=TODAY()", "fmt": "dd-mm-yyyy"}, "A2": "Deadline", "B2": {"v": 46387, "fmt": "dd-mm-yyyy"}, "A3": "Days left", "B3": "=B2-B1"}, "widths": {"A": 16, "B": 12, "C": 12, "D": 14, "E": 14}}]}, "cell": "B3", "say": "Dates are numbers, so you can subtract them."}, "mistakes": ["Typing a date with Ctrl+; when you need it fixed, and TODAY() when you need it live, not the other way round."], "related": ["NOW", "DATE"]}, {"name": "NOW", "cat": "Date & time", "course": "C2", "short": "Date and time now", "what": "Returns the current date and time.", "syntax": "=NOW()", "args": [], "example": {"sheet": {"sheets": [{"name": "Try it", "cells": {"A1": "Now", "B1": {"f": "=NOW()", "fmt": "dd-mm-yyyy hh:mm"}}, "widths": {"A": 16, "B": 12, "C": 12, "D": 14, "E": 14}}]}, "cell": "B1", "say": ""}, "mistakes": ["It changes on every recalculation, so don’t use it to stamp when something happened."], "related": ["TODAY"]}, {"name": "DATE", "cat": "Date & time", "course": "C2", "short": "Build a date", "what": "Makes a real date from a year, month and day.", "syntax": "=DATE(year, month, day)", "args": [["year", "Four-digit year"], ["month", "1 to 12 (more rolls into next year)"], ["day", "Day of the month"]], "example": {"sheet": {"sheets": [{"name": "Try it", "cells": {"A1": 2026, "B1": 3, "C1": 31, "D1": {"f": "=DATE(A1,B1,C1)", "fmt": "dd-mm-yyyy"}}, "widths": {"A": 16, "B": 12, "C": 12, "D": 14, "E": 14}}]}, "cell": "D1", "say": "Change the month to 13 and see it roll into January 2027."}, "mistakes": [], "related": ["YEAR", "MONTH", "DAY"]}, {"name": "YEAR", "cat": "Date & time", "course": "C2", "short": "Year of a date", "what": "Returns the year of a date.", "syntax": "=YEAR(date)", "args": [["date", "A real date"]], "example": {"sheet": {"sheets": [{"name": "Try it", "cells": {"A1": {"v": 46100, "fmt": "dd-mm-yyyy"}, "B1": "=YEAR(A1)", "C1": "=MONTH(A1)", "D1": "=DAY(A1)"}, "widths": {"A": 16, "B": 12, "C": 12, "D": 14, "E": 14}}]}, "cell": "B1", "say": ""}, "mistakes": ["If the date is really text, YEAR gives #VALUE!."], "related": ["MONTH", "DAY"]}, {"name": "MONTH", "cat": "Date & time", "course": "C2", "short": "Month number of a date", "what": "Returns the month, 1 to 12.", "syntax": "=MONTH(date)", "args": [["date", "A real date"]], "example": {"sheet": {"sheets": [{"name": "Try it", "cells": {"A1": {"v": 46100, "fmt": "dd-mm-yyyy"}, "B1": "=MONTH(A1)"}, "widths": {"A": 16, "B": 